{
  "name": "ajch-fin-manager",
  "version": "0.1.0",
  "description": "Finance Manager - Multi-provider AI on Cloudflare Workers + Pages",
  "main": "src/worker.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "pages:deploy": "wrangler pages deploy public/ --project-name=ajch-fin-manager",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:integration": "jest src/__tests__/integration.test.ts",
    "test:security": "jest src/__tests__/security.test.ts",
    "test:uat": "jest src/__tests__/uat.test.ts",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "format": "prettier --write ."
  },
  "dependencies": {
    "google-auth-library": "^9.4.1",
    "jose": "^5.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@playwright/test": "^1.40.1",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "jest": "^29.7.0",
    "playwright": "^1.40.1",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
