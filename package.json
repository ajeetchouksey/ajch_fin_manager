{
  "name": "ajch-fin-manager",
  "version": "0.1.0",
  "description": "Finance Manager - Multi-provider AI on Cloudflare Workers + Pages",
  "main": "src/worker.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "pages:deploy": "wrangler pages deploy public/ --project-name=ajch-fin-manager",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "format": "prettier --write ."
  },
  "dependencies": {
    "google-auth-library": "^9.4.1",
    "jose": "^5.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "wrangler": "^3.26.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
