{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    // The shared library (web app and connector use the same figures)
    "paths": { "@finbuddy/core/*": ["../frontend/src/lib/*"] }
  },
  "include": ["src", "test"]
}
